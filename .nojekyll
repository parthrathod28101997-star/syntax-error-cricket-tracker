<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TV Broadcast Cricket Scoreboard</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Arial Black', -apple-system, sans-serif; }
    body { background-color: #0b0f19; color: #ffffff; padding: 12px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
    .screen-wrapper { width: 100%; max-width: 920px; display: flex; flex-direction: column; gap: 16px; }

    /* TV BROADCAST HUD BAR */
    .tv-broadcast-bar {
      width: 100%;
      background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
      border-radius: 8px;
      border-top: 3px solid #38bdf8;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      overflow: hidden;
    }

    .tv-header-strip {
      background: #0284c7;
      display: flex;
      justify-content: space-between;
      padding: 4px 12px;
      font-size: 0.75rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 900;
    }

    .tv-main-scoreboard {
      display: grid;
      grid-template-columns: 110px 1.4fr 1.6fr;
      align-items: center;
      background: #090d16;
    }

    /* TEAM & SCORE BLOCK */
    .tv-team-badge {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      padding: 14px 8px;
      text-align: center;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-right: 2px solid #38bdf8;
    }
    .tv-team-badge .code { font-size: 1.8rem; font-weight: 900; line-height: 1; }
    .tv-team-badge .sub { font-size: 0.65rem; color: #93c5fd; font-weight: 700; margin-top: 4px; }

    .tv-score-box {
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-right: 1px solid #1e293b;
    }
    .tv-runs-wickets { font-size: 2.8rem; font-weight: 900; line-height: 1; letter-spacing: -1px; }
    .tv-runs-wickets span { color: #f59e0b; }
    .tv-overs-crr { font-size: 0.85rem; color: #94a3b8; margin-top: 6px; font-weight: 700; }
    .tv-overs-crr b { color: #ffffff; }

    /* BATSMEN & BOWLER STATS STRIP */
    .tv-players-box {
      padding: 10px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 0.85rem;
    }
    .player-row { display: flex; justify-content: space-between; align-items: center; }
    .player-name { display: flex; align-items: center; gap: 6px; color: #f1f5f9; font-weight: 800; }
    .strike-star { color: #38bdf8; font-size: 0.9rem; }
    .player-stats { color: #38bdf8; font-weight: 900; }
    .player-stats small { color: #64748b; font-weight: 700; }
    .bowler-row { border-top: 1px solid #1e293b; padding-top: 4px; margin-top: 2px; }

    /* THIS OVER STRIP */
    .tv-this-over-ribbon {
      background: #0f172a;
      border-top: 1px solid #1e293b;
      padding: 6px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.75rem;
    }
    .over-balls-container { display: flex; gap: 6px; align-items: center; }
    .ball-circle {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #1e293b;
      border: 1px solid #475569;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 900;
    }
    .ball-circle.four { background: #0284c7; border-color: #38bdf8; }
    .ball-circle.six { background: #16a34a; border-color: #4ade80; }
    .ball-circle.wicket { background: #dc2626; border-color: #f87171; }
    .ball-circle.wide { background: #d97706; border-color: #fbbf24; font-size: 0.65rem; }

    /* CONTROLLER PANEL */
    .tv-controls {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 8px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .control-title { font-size: 0.75rem; text-transform: uppercase; color: #9ca3af; letter-spacing: 0.5px; }
    .btn-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
    .btn-action-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .settings-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .settings-grid input { padding: 8px; border-radius: 6px; border: 1px solid #374151; background: #090d16; color: white; font-size: 0.8rem; font-weight: 700; width: 100%; }
    .settings-grid button { background: #0284c7; border: none; border-radius: 6px; padding: 8px; font-weight: 900; color: white; cursor: pointer; }
    
    .c-btn {
      padding: 10px 0;
      border: none;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: 900;
      color: white;
      cursor: pointer;
    }
    .c-btn:active { transform: scale(0.97); }
    .c-btn-run { background: #1f2937; border: 1px solid #374151; }
    .c-btn-boundary { background: #0369a1; }
    .c-btn-six { background: #15803d; }
    .c-btn-extra { background: #b45309; }
    .c-btn-wkt { background: #b91c1c; }
    .c-btn-strike { background: #4338ca; }
    .c-btn-reset { background: #475569; }

    @media (max-width: 600px) {
      .tv-main-scoreboard { grid-template-columns: 85px 1fr; }
      .tv-players-box { grid-column: span 2; border-top: 1px solid #1e293b; }
      .tv-team-badge .code { font-size: 1.4rem; }
      .tv-runs-wickets { font-size: 2.2rem; }
      .btn-row { grid-template-columns: repeat(3, 1fr); }
      .btn-action-row { grid-template-columns: repeat(2, 1fr); }
      .settings-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

  <div class="screen-wrapper">
    <!-- BROADCAST ON-SCREEN DISPLAY (HUD) -->
    <div class="tv-broadcast-bar">
      <div class="tv-header-strip">
        <span id="matchTitleText">T20 WORLD SERIES • FINAL</span>
        <span id="targetStatusText">FIRST INNINGS</span>
      </div>

      <div class="tv-main-scoreboard">
        <!-- TEAM -->
        <div class="tv-team-badge">
          <div class="code" id="teamBadgeText">IND</div>
          <div class="sub" id="innText">1ST INN</div>
        </div>

        <!-- SCORE & OVERS -->
        <div class="tv-score-box">
          <div class="tv-runs-wickets"><span id="runs">0</span>/<span id="wickets">0</span></div>
          <div class="tv-overs-crr">
            OVERS <b id="overs">0.0</b> &nbsp;|&nbsp; CRR <b id="crr">0.00</b>
          </div>
        </div>

        <!-- BATSMEN & BOWLER METRICS -->
        <div class="tv-players-box">
          <div class="player-row">
            <span class="player-name"><span id="star1" class="strike-star">▶</span> <span id="bat1NameText">Rohit</span></span>
            <span class="player-stats"><span id="bat1Runs">0</span> <small>(<span id="bat1Balls">0</span>)</small></span>
          </div>
          <div class="player-row">
            <span class="player-name"><span id="star2" class="strike-star" style="visibility: hidden;">▶</span> <span id="bat2NameText">Virat</span></span>
            <span class="player-stats"><span id="bat2Runs">0</span> <small>(<span id="bat2Balls">0</span>)</small></span>
          </div>
          <div class="player-row bowler-row">
            <span class="player-name" style="color: #94a3b8;"><span style="color:#ef4444; font-size:0.75rem;">●</span> <span id="bowlerNameText">Starc</span></span>
            <span class="player-stats" style="color:#f59e0b;"><span id="bowlWkts">0</span>-<span id="bowlRuns">0</span> <small>(<span id="bowlOvers">0.0</span>)</small></span>
          </div>
        </div>
      </div>

      <!-- BOTTOM OVER TICKER -->
      <div class="tv-this-over-ribbon">
        <span style="color:#64748b; font-weight:800;">THIS OVER</span>
        <div class="over-balls-container" id="overCircles">
          <span style="color:#475569;">Ball not bowled</span>
        </div>
      </div>
    </div>

    <!-- QUICK NAMES & TARGET SETTINGS -->
    <div class="tv-controls">
      <div class="control-title">Edit Match Details</div>
      <div class="settings-grid">
        <input type="text" id="inTeam" placeholder="Team (e.g. IND)">
        <input type="text" id="inBat1" placeholder="Striker">
        <input type="text" id="inBat2" placeholder="Non-Striker">
        <input type="text" id="inBowler" placeholder="Bowler">
        <input type="number" id="inTarget" placeholder="Target runs">
        <button onclick="applySettings()" style="grid-column: span 3;">Apply Match Info</button>
      </div>
    </div>

    <!-- BROADCAST OPERATOR CONSOLE -->
    <div class="tv-controls">
      <div class="control-title">Add Runs (Current Striker)</div>
      <div class="btn-row">
        <button class="c-btn c-btn-run" onclick="addBall(0, '0')">0</button>
        <button class="c-btn c-btn-run" onclick="addBall(1, '1')">1</button>
        <button class="c-btn c-btn-run" onclick="addBall(2, '2')">2</button>
        <button class="c-btn c-btn-run" onclick="addBall(3, '3')">3</button>
        <button class="c-btn c-btn-boundary" onclick="addBall(4, '4')">4 (Four)</button>
        <button class="c-btn c-btn-six" onclick="addBall(6, '6')">6 (Six)</button>
      </div>

      <div class="control-title">Extras, Wickets & Control</div>
      <div class="btn-action-row">
        <button class="c-btn c-btn-extra" onclick="addExtra('Wd')">Wide (Wd)</button>
        <button class="c-btn c-btn-extra" onclick="addExtra('Nb')">No Ball (Nb)</button>
        <button class="c-btn c-btn-wkt" onclick="takeWicket()">WICKET</button>
        <button class="c-btn c-btn-strike" onclick="rotateStrike()">Rotate Strike ⇄</button>
      </div>
      <div style="margin-top:4px;">
        <button class="c-btn c-btn-reset" onclick="resetMatch()" style="width:100%; padding:8px 0; font-size:0.85rem;">Reset New Match</button>
      </div>
    </div>
  </div>

  <script>
    let score = { runs: 0, wickets: 0, legalBalls: 0 };
    let striker = 1;
    let b1 = { runs: 0, balls: 0 };
    let b2 = { runs: 0, balls: 0 };
    let bowler = { runs: 0, balls: 0, wkts: 0 };
    let target = null;
    let overHistory = [];

    function render() {
      document.getElementById('runs').textContent = score.runs;
      document.getElementById('wickets').textContent = score.wickets;

      const completedOvers = Math.floor(score.legalBalls / 6);
      const ballsInOver = score.legalBalls % 6;
      document.getElementById('overs').textContent = `${completedOvers}.${ballsInOver}`;

      const crr = score.legalBalls > 0 ? ((score.runs / score.legalBalls) * 6).toFixed(2) : "0.00";
      document.getElementById('crr').textContent = crr;

      document.getElementById('bat1Runs').textContent = b1.runs;
      document.getElementById('bat1Balls').textContent = b1.balls;
      document.getElementById('bat2Runs').textContent = b2.runs;
      document.getElementById('bat2Balls').textContent = b2.balls;

      const bOvers = Math.floor(bowler.balls / 6);
      const bBalls = bowler.balls % 6;
      document.getElementById('bowlOvers').textContent = `${bOvers}.${bBalls}`;
      document.getElementById('bowlRuns').textContent = bowler.runs;
      document.getElementById('bowlWkts').textContent = bowler.wkts;

      document.getElementById('star1').style.visibility = striker === 1 ? 'visible' : 'hidden';
      document.getElementById('star2').style.visibility = striker === 2 ? 'visible' : 'hidden';

      if (target) {
        const needed = target - score.runs;
        if (needed > 0) {
          document.getElementById('targetStatusText').textContent = `NEED ${needed} RUNS`;
        } else {
          document.getElementById('targetStatusText').textContent = `TARGET ACHIEVED!`;
        }
      }

      const overBox = document.getElementById('overCircles');
      if (overHistory.length === 0) {
        overBox.innerHTML = '<span style="color:#475569;">Ball not bowled</span>';
      } else {
        overBox.innerHTML = overHistory.map(b => {
          let cls = '';
          if (b === '4') cls = 'four';
          else if (b === '6') cls = 'six';
          else if (b === 'W') cls = 'wicket';
          else if (b.includes('Wd') || b.includes('Nb')) cls = 'wide';
          return `<div class="ball-circle ${cls}">${b}</div>`;
        }).join('');
      }
    }

    function addBall(runs, label) {
      if (score.wickets >= 10) return alert('Innings Finished');
      score.runs += runs;
      score.legalBalls += 1;
      bowler.runs += runs;
      bowler.balls += 1;

      if (striker === 1) { b1.runs += runs; b1.balls += 1; }
      else { b2.runs += runs; b2.balls += 1; }

      overHistory.push(label);

      if (runs % 2 !== 0) striker = (striker === 1) ? 2 : 1;

      if (score.legalBalls % 6 === 0) {
        overHistory = [];
        striker = (striker === 1) ? 2 : 1;
      }
      render();
    }

    function addExtra(type) {
      if (score.wickets >= 10) return;
      score.runs += 1;
      bowler.runs += 1;
      overHistory.push(type);
      render();
    }

    function takeWicket() {
      if (score.wickets >= 10) return alert('All Out!');
      score.wickets += 1;
      score.legalBalls += 1;
      bowler.wkts += 1;
      bowler.balls += 1;

      if (striker === 1) { b1.balls += 1; b1 = { runs: 0, balls: 0 }; }
      else { b2.balls += 1; b2 = { runs: 0, balls: 0 }; }

      overHistory.push('W');
      if (score.legalBalls % 6 === 0) {
        overHistory = [];
        striker = (striker === 1) ? 2 : 1;
      }
      render();
    }

    function rotateStrike() {
      striker = (striker === 1) ? 2 : 1;
      render();
    }

    function applySettings() {
      const tm = document.getElementById('inTeam').value.trim();
      const b1Name = document.getElementById('inBat1').value.trim();
      const b2Name = document.getElementById('inBat2').value.trim();
      const bwName = document.getElementById('inBowler').value.trim();
      const tg = parseInt(document.getElementById('inTarget').value);

      if (tm) document.getElementById('teamBadgeText').textContent = tm.toUpperCase();
      if (b1Name) document.getElementById('bat1NameText').textContent = b1Name;
      if (b2Name) document.getElementById('bat2NameText').textContent = b2Name;
      if (bwName) document.getElementById('bowlerNameText').textContent = bwName;
      if (!isNaN(tg) && tg > 0) {
        target = tg;
        document.getElementById('innText').textContent = '2ND INN';
      }
      render();
    }

    function resetMatch() {
      score = { runs: 0, wickets: 0, legalBalls: 0 };
      striker = 1;
      b1 = { runs: 0, balls: 0 };
      b2 = { runs: 0, balls: 0 };
      bowler = { runs: 0, balls: 0, wkts: 0 };
      overHistory = [];
      target = null;
      document.getElementById('targetStatusText').textContent = 'FIRST INNINGS';
      document.getElementById('innText').textContent = '1ST INN';
      render();
    }
  </script>
</body>
</html>
